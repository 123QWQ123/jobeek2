{
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "npx nuxi clean && nuxt dev --port=3033",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy-stage": "nuxt generate && scp -r ./.output/public/* jobeek:~/web/nuxt",
    "deploy-stage-ssr": "nuxt build && scp -rp g+rwx ./.output/* jobeek:~/web/nuxt",
    "upload-stage-ssr": "scp -rp g+rwx ./.output/* jobeek:~/web/nuxt",
    "upload-stage-using-rsync": "rsync -rt --chmod=u+rwx,g+rwx,o+rx ./.output/* jobeek:~/web/nuxt"
  },
